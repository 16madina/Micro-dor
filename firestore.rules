rules_version = '2';

// Règles de sécurité MICRO D'OR
// - Chaque personne ne voit et ne modifie que son propre profil.
// - Le rôle « organisateur » exige le code d'accès, vérifié ici (jamais dans l'application).
// - La boutique est lisible par tous, modifiable seulement par les organisateurs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOrganizer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organisateur';
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['eleve', 'parent', 'organisation', 'organisateur']
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role != 'organisateur' || request.resource.data.orgCode == 'MICRO');

      // le rôle et le code ne peuvent jamais être modifiés après la création
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('orgCode', null) == resource.data.get('orgCode', null)
        && request.resource.data.get('details', {}).get('consentementParental', null)
           == resource.data.get('details', {}).get('consentementParental', null);

      allow delete: if false;
    }

    match /produits/{id} {
      allow read: if true;
      allow write: if isOrganizer();
    }

    // ---------- Encouragements et votes ----------
    function talentIds() {
      return ['maya-l', 'karim-s', 'rosalie-d', 'sarah-m', 'jade-t', 'samuel-p', 'nathan-b', 'ines-b', 'theo-m', 'lea-r', 'olivier-g', 'chloe-v', 'malik-d', 'amira-h', 'felix-l', 'adam-k', 'alex-t', 'noemie-j', 'emma-c', 'yanis-a', 'william-r', 'zoe-p', 'mathis-c', 'aicha-n'];
    }
    function realAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function fanPath(tid) {
      return /databases/$(database)/documents/talents/$(tid)/fans/$(request.auth.uid);
    }
    function ballotPath(cat) {
      return /databases/$(database)/documents/bulletins/$(cat + '_' + request.auth.uid);
    }
    // l'encouragement ne bouge que de 1, et seulement avec la fiche « fan » correspondante
    function encOk(tid) {
      let d = request.resource.data.encouragements - resource.data.encouragements;
      return d == 0
        || (d == 1 && !exists(fanPath(tid)) && existsAfter(fanPath(tid)))
        || (d == -1 && exists(fanPath(tid)) && !existsAfter(fanPath(tid)));
    }
    // les votes ne font que monter, du nombre exact de votes achetés dans le bulletin de la personne
    function voteOk(tid) {
      let d = request.resource.data.votes - resource.data.votes;
      let b = ballotPath(resource.data.category);
      return d == 0
        || (d in [1, 5, 10] && existsAfter(b)
            && getAfter(b).data.parts.get(tid, 0) == (exists(b) ? get(b).data.parts.get(tid, 0) : 0) + d);
    }

    match /talents/{tid} {
      allow read: if true;
      allow create: if signedIn()
        && tid in talentIds()
        && request.resource.data.keys().hasOnly(['category', 'encouragements', 'votes'])
        && request.resource.data.category in ['chant', 'slam', 'rap', 'danse', 'theatre']
        && request.resource.data.encouragements == 0
        && request.resource.data.votes == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encouragements', 'votes'])
        && encOk(tid) && voteOk(tid);
      allow delete: if false;

      match /fans/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && getAfter(/databases/$(database)/documents/talents/$(tid)).data.encouragements
             == get(/databases/$(database)/documents/talents/$(tid)).data.encouragements + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/talents/$(tid)).data.encouragements
             == get(/databases/$(database)/documents/talents/$(tid)).data.encouragements - 1;
        allow update: if false;
      }
    }

    // ---------- Votes payants ----------
    // Forfaits : 1, 5 ou 10 votes. Plafond : 10 votes par personne et par discipline.
    // Paiement SIMULÉ pour l'instant. Avec un vrai paiement (Stripe), ces écritures
    // passeront par une fonction serveur et seront fermées aux applications.
    function canPay() {
      return realAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('details', {})
             .get('consentementParental', 'ok') != 'en_attente';
    }
    function talentDoc(tid) {
      return /databases/$(database)/documents/talents/$(tid);
    }
    // achat de n votes pour tid : bulletin, plafond et compteur du talent concordent
    function purchaseOk(tid, oldPart, n) {
      let b = request.resource.data;
      return tid in talentIds()
        && n in [1, 5, 10]
        && b.parts[tid] == oldPart + n
        && b.total <= 10
        && get(talentDoc(tid)).data.category == b.category
        && getAfter(talentDoc(tid)).data.votes == get(talentDoc(tid)).data.votes + n;
    }

    // un bulletin par compte et par discipline : l'identifiant est « discipline_uid »,
    // « dernier » nomme le talent du dernier achat (le seul dont la part change)
    match /bulletins/{bid} {
      // lisible seulement par son auteur (même s'il n'existe pas encore)
      allow read: if signedIn() && bid.split('_')[1] == request.auth.uid;
      allow create: if canPay()
        && bid == request.resource.data.category + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'category', 'total', 'parts', 'dernier', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.parts.keys().hasOnly([request.resource.data.dernier])
        && purchaseOk(request.resource.data.dernier, 0, request.resource.data.total);
      // on ne peut qu'ajouter des votes : jamais en retirer ni les déplacer
      allow update: if canPay()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category == resource.data.category
        && request.resource.data.keys().hasOnly(['uid', 'category', 'total', 'parts', 'dernier', 'at'])
        && request.resource.data.parts.diff(resource.data.parts).affectedKeys().hasOnly([request.resource.data.dernier])
        && purchaseOk(
             request.resource.data.dernier,
             resource.data.parts.get(request.resource.data.dernier, 0),
             request.resource.data.total - resource.data.total);
      allow delete: if false;
    }

    // tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
